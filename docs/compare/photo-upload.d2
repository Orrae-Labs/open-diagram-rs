direction: right
Clients: {
  mobile: "Mobile app\n• iOS\n• Android"
  web: "Web app\n• Upload page\n• Feed page"
}
Backend: {
  gateway: "API gateway\n• Sign-in check\n• Rate limits"
  upload: "Upload service\n• Checks file type\n• Saves original"
  feed: "Feed service\n• Builds each feed\n• Caches pages"
  queue: "Job queue\n• One job per photo"
  workers: "Thumbnail workers\n• Three sizes\n• Retries on failure"
}
Data: {
  storage: "Photo storage\n• Originals\n• Thumbnails"
  db: "Feed database\n• Posts\n• Follows"
}
recs: "Recommendations\n• Suggested photos"
Clients.mobile -> Backend.gateway
Clients.web -> Backend.gateway
Backend.gateway -> Backend.upload
Backend.gateway -> Backend.feed
Backend.upload -> Data.storage: original
Backend.upload -> Backend.queue: new photo
Backend.queue -> Backend.workers
Backend.workers -> Data.storage: thumbnails
Backend.feed -> Data.db
Backend.feed -> recs: {style.stroke-dash: 4}
